-			const write = () => sessionStorage.setItem(key, JSON.stringify(draft));
-			if (debounce) {
-				saveDraftTimeout = setTimeout(write, 500);
-			} else {
-				write();
-			}
-		} else {
-			sessionStorage.removeItem(`chat-input${chatId ? `-${chatId}` : ''}`);
+		// Protected fork: uninspected composer contents are RAM-only.
+		if (saveDraftTimeout) clearTimeout(saveDraftTimeout);
+		for (const key of Object.keys(sessionStorage)) {
+			if (key === 'chat-input' || key.startsWith('chat-input-')) sessionStorage.removeItem(key);
 		}
 	};
 
