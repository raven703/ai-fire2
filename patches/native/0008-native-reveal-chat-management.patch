From e3180eb1c1b857db811c5209152dab6315911710 Mon Sep 17 00:00:00 2001
From: Raven703 <raven703@gmail.com>
Date: Thu, 12 Nov 2026 14:31:53 +0300
Subject: [PATCH] Checkpoint verified native reveal and chat management UI

---
 src/lib/components/chat/Chat.svelte           |  5 +++
 .../chat/Messages/UserMessage.svelte          | 35 +++++++++++++++++++
 .../components/layout/Sidebar/ChatItem.svelte |  2 +-
 3 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/src/lib/components/chat/Chat.svelte b/src/lib/components/chat/Chat.svelte
index 55dcd4db6..1ff4d042c 100644
--- a/src/lib/components/chat/Chat.svelte
+++ b/src/lib/components/chat/Chat.svelte
@@ -457,6 +457,8 @@
 			nativeRevision = canonical.revision;
 			history = structuredClone(chat.chat.history);
 			chatId.set(chat.id);
+			chatTitle.set(chat.title);
+			await refreshChatList(localStorage.token);
 			prompt = '';
 			if (!embedded) window.history.replaceState(window.history.state, '', `/c/${chat.id}`);
 			if (canonical.error) toast.error('Response unavailable; checked input retained');
@@ -2906,6 +2908,9 @@
 		}
 		await chatId.set('');
 		await chatTitle.set('');
+		// A new native conversation must not retain the previous server scope.
+		chat = null;
+		nativeRevision = null;
 
 		history = {
 			messages: {},
diff --git a/src/lib/components/chat/Messages/UserMessage.svelte b/src/lib/components/chat/Messages/UserMessage.svelte
index 8ac72335c..52c3f75b7 100644
--- a/src/lib/components/chat/Messages/UserMessage.svelte
+++ b/src/lib/components/chat/Messages/UserMessage.svelte
@@ -36,6 +36,34 @@
 	export let user;
 
 	export let chatId;
+	// Display-only RAM state; never bind originals into message/history/composer.
+	let revealedOriginal: string | null = null;
+	let revealError = false;
+	let revealBusy = false;
+	let revealScope = '';
+	$: if (revealScope !== `${chatId}:${messageId}`) {
+		revealScope = `${chatId}:${messageId}`;
+		revealedOriginal = null;
+		revealError = false;
+	}
+	const revealOriginal = async () => {
+		revealBusy = true;
+		revealError = false;
+		try {
+			const headers = { Authorization: `Bearer ${localStorage.token}` };
+			const state = await fetch(`/api/v1/chats/${chatId}/native`, { headers, cache: 'no-store' });
+			if (!state.ok) throw new Error();
+			const canonical = await state.json();
+			const response = await fetch(`/api/v1/chats/${chatId}/native/reveal`, {
+				method: 'POST', cache: 'no-store',
+				headers: { ...headers, 'Content-Type': 'application/json' },
+				body: JSON.stringify({ message_id: messageId, revision: canonical.revision })
+			});
+			if (!response.ok) throw new Error();
+			revealedOriginal = (await response.json()).content;
+		} catch { revealError = true; }
+		finally { revealBusy = false; }
+	};
 	export let history;
 	export let messageId;
 	export let selectedModels: string[] = [];
@@ -434,6 +462,13 @@
 				<SubagentResultRow content={message.content} result={message.meta} />
 			{:else if message.content !== ''}
 				<div class="w-full">
+					{#if !readOnly && message.content.includes('[V2_')}
+						<button class="text-xs underline" disabled={revealBusy} on:click={() => revealedOriginal === null ? revealOriginal() : (revealedOriginal = null)}>
+							{revealedOriginal === null ? 'Показать оригинал' : 'Скрыть оригинал'}
+						</button>
+						{#if revealedOriginal !== null}<div data-testid="revealed-original" class="whitespace-pre-wrap">{revealedOriginal}</div>{/if}
+						{#if revealError}<div role="alert">Раскрытие недоступно</div>{/if}
+					{/if}
 					<div
 						class="flex {($settings?.chatBubble ?? true)
 							? `${isOwn ? 'justify-end' : 'justify-start'} pb-1`
diff --git a/src/lib/components/layout/Sidebar/ChatItem.svelte b/src/lib/components/layout/Sidebar/ChatItem.svelte
index 0ec0952f5..8a07d51d2 100644
--- a/src/lib/components/layout/Sidebar/ChatItem.svelte
+++ b/src/lib/components/layout/Sidebar/ChatItem.svelte
@@ -741,7 +741,7 @@
 		</div>
 	{:else}
 		<div id="sidebar-chat-item" class={chatItemClass}>
-			{#if selecting}
+			{#if chatSelection && !readonly}
 				<button
 					type="button"
 					role="checkbox"
