From 95fa1c9ad9d4d8a1f56db1cec657973edc7371c1 Mon Sep 17 00:00:00 2001
From: Raven703 <raven703@gmail.com>
Date: Wed, 11 Nov 2026 17:32:52 +0300
Subject: [PATCH] Keep protected chat layout volatile without denied autosave
 requests

---
 src/lib/apis/chats/view.ts | 26 +++++++++++---------------
 1 file changed, 11 insertions(+), 15 deletions(-)

diff --git a/src/lib/apis/chats/view.ts b/src/lib/apis/chats/view.ts
index 0007c2ec1..02a19cda2 100644
--- a/src/lib/apis/chats/view.ts
+++ b/src/lib/apis/chats/view.ts
@@ -1,19 +1,15 @@
-import { WEBUI_API_BASE_URL } from '$lib/constants';
 import type { ChatViewState } from '$lib/components/chat/ChatTabs/tabs';
 
-async function request(id: string, state?: ChatViewState) {
-	const response = await fetch(`${WEBUI_API_BASE_URL}/chats/${encodeURIComponent(id)}/view`, {
-		method: state ? 'POST' : 'GET',
-		headers: {
-			Authorization: `Bearer ${localStorage.token ?? ''}`,
-			'Content-Type': 'application/json'
-		},
-		...(state ? { body: JSON.stringify({ state }) } : {})
-	});
-	if (!response.ok) throw new Error(`Chat view request failed (${response.status})`);
-	return response.json();
-}
+// Protected text fork: auxiliary layout is session-memory only. Panel labels,
+// paths and prompts are not admitted content and must not reach a writer or
+// browser persistence. Keep the original panel lifecycle, without autosave.
+const volatileViews = new Map<string, ChatViewState>();
 
-export const getChatView = (id: string): Promise<{ state: ChatViewState | null }> => request(id);
+export const getChatView = async (id: string): Promise<{ state: ChatViewState | null }> => ({
+	state: volatileViews.has(id) ? structuredClone(volatileViews.get(id)!) : null
+});
 export const updateChatView = (id: string, state: ChatViewState): Promise<{ updated_at: number }> =>
-	request(id, state);
+	Promise.resolve().then(() => {
+		volatileViews.set(id, structuredClone(state));
+		return { updated_at: Math.floor(Date.now() / 1000) };
+	});
-- 
2.34.1

