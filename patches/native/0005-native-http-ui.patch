 		{
 			method: 'GET',
 			headers: {
diff --git a/src/lib/components/chat/Chat.svelte b/src/lib/components/chat/Chat.svelte
index 5474a82ef..55dcd4db6 100644
--- a/src/lib/components/chat/Chat.svelte
+++ b/src/lib/components/chat/Chat.svelte
@@ -435,6 +435,39 @@
 	}
 
 	let chat: any = null;
+	let nativeRevision: string | null = null;
+	const submitNativeTurn = async (content: string, attachments: any[]) => {
+		if (attachments.length) throw new Error('Protected chat supports text only');
+		generating = true;
+		try {
+			const response = await fetch('/api/chat/completions/native', {
+				method: 'POST',
+				headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${localStorage.token}` },
+				body: JSON.stringify({
+					chat_id: chat?.id ?? null,
+					revision: nativeRevision,
+					parent_id: history.currentId ?? null,
+					message_id: uuidv4(),
+					content
+				})
+			});
+			if (!response.ok) throw new Error('Protected message rejected');
+			const canonical = await response.json();
+			chat = canonical.chat;
+			nativeRevision = canonical.revision;
+			history = structuredClone(chat.chat.history);
+			chatId.set(chat.id);
+			prompt = '';
+			if (!embedded) window.history.replaceState(window.history.state, '', `/c/${chat.id}`);
+			if (canonical.error) toast.error('Response unavailable; checked input retained');
+			await tick();
+			autoScrollToBottom();
+		} catch (error) {
+			toast.error('Protected message rejected; no unchecked response published');
+		} finally {
+			generating = false;
+		}
+	};
 	let tags = [];
 
 	// Non-owners may reply when the sharing mode allows it, but cannot save chat edits.
@@ -2989,6 +3022,21 @@
 	};
 
 	const loadChat = async (signal = startChatLoad()) => {
+		const nativeId = chatIdProp || $chatId;
+		if (nativeId) {
+			const response = await fetch(`/api/v1/chats/${nativeId}/native`, {
+				headers: { Authorization: `Bearer ${localStorage.token}` }, signal
+			});
+			if (!response.ok) { toast.error('Protected history unavailable'); return; }
+			const canonical = await response.json();
+			chat = canonical.chat;
+			nativeRevision = canonical.revision;
+			history = structuredClone(chat.chat.history);
+			selectedModels = ['mock'];
+			chatId.set(chat.id);
+			loading = false;
+			return true;
+		}
 		if (chatIdProp && chatIdProp !== $chatId) terminalTabs?.prepareChatSwitch();
 		if (chatIdProp && chatIdProp !== $chatId) {
 			terminalContext = null;
@@ -3756,6 +3804,9 @@
 		inputFiles: any[],
 		bridgeRequest: { userMessageId: string; modelId: string } | null = null
 	) => {
+		// Native text contract is server-authoritative. Never construct or persist
+		// an optimistic raw message via the legacy completion/save lifecycle.
+		return await submitNativeTurn(inputContent, inputFiles);
 		if (selectedModels.includes('')) throw new Error($i18n.t('Model not selected'));
 		const _files = structuredClone(inputFiles);
 
