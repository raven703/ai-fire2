From 46c76a3b14579716c0d34e96e98d3202ee981be3 Mon Sep 17 00:00:00 2001
From: Raven703 <raven703@gmail.com>
Date: Wed, 11 Nov 2026 15:19:57 +0300
Subject: [PATCH] Bound Rollup file concurrency for constrained native builds

---
 vite.config.ts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/vite.config.ts b/vite.config.ts
index 30b204424..32b244a73 100644
--- a/vite.config.ts
+++ b/vite.config.ts
@@ -43,6 +43,11 @@ export default defineConfig({
 	build: {
 		target: 'es2022',
 		minify: false,
+		// Bound Rollup's expensive global analysis in constrained local builds.
+		rollupOptions: {
+			treeshake: false,
+			maxParallelFileOps: 8
+		},
 		// Large native builds must fit the local 8 GiB WSL environment.
 		sourcemap: process.env.FIREWALL_BUILD_SOURCEMAP === 'true'
 	},
-- 
2.34.1

