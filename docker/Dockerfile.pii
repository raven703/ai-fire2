FROM python:3.12-slim
WORKDIR /app
COPY config/pii-requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r /app/requirements.lock uvicorn==0.38.0 sqlalchemy==2.0.48 aiosqlite==0.22.1
COPY src /app/src
COPY tests /app/tests
COPY config /app/config
ENV PYTHONPATH=/app/src OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
CMD ["pytest", "-q", "/app/tests/test_detection.py"]