FROM node:22-bookworm-slim AS frontend
WORKDIR /webui
ENV CYPRESS_INSTALL_BINARY=0
COPY .build/open-webui/package.json .build/open-webui/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY .build/open-webui/ ./
# No Python-in-browser, GPU, model or Pyodide downloads. Vite builds SvelteKit.
RUN node node_modules/@sveltejs/kit/svelte-kit.js sync && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build

FROM ghcr.io/open-webui/open-webui:v0.13.3@sha256:46b59158e6558eeb980bc828e0f1b30238ad24d82ed84d5e5eda1dab2a082f14
COPY --from=frontend /webui/build /app/build
COPY src/ai_firewall /app/backend/ai_firewall
COPY docker/main.py /app/backend/open_webui/main.py
ENV OFFLINE_MODE=true HF_HUB_OFFLINE=1 RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
CMD ["uvicorn", "open_webui.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]