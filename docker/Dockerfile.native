# Preparatory build ONLY. No runtime admission integration yet. Never expose it.
FROM node:22-bookworm-slim AS frontend
WORKDIR /webui
ENV CYPRESS_INSTALL_BINARY=0
ENV NODE_OPTIONS=--max-old-space-size=3072
COPY forks/open-webui/package.json forks/open-webui/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY forks/open-webui/ ./
RUN node node_modules/@sveltejs/kit/svelte-kit.js sync && node node_modules/vite/bin/vite.js build

FROM ghcr.io/open-webui/open-webui:v0.13.3@sha256:46b59158e6558eeb980bc828e0f1b30238ad24d82ed84d5e5eda1dab2a082f14
COPY --from=frontend /webui/build /app/build
COPY forks/open-webui/backend/open_webui /app/backend/open_webui
COPY src/ai_firewall /app/backend/ai_firewall
ENV OFFLINE_MODE=true HF_HUB_OFFLINE=1 RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
ENTRYPOINT ["uvicorn", "ai_firewall.native_runtime:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]