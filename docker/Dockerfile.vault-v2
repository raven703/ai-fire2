FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.162.4 httpx==0.28.1 uvicorn==0.38.0 psycopg[binary]==3.2.9 cryptography==48.0.1
COPY src /app/src
ENV PYTHONPATH=/app/src
CMD ["uvicorn","ai_firewall.vault_v2:app","--host","0.0.0.0","--port","8000","--no-access-log","--log-level","critical"]